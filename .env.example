# Copy to .env for local dev. Never commit the real .env.
# In production (Render), set these as real environment variables on the
# Web Service instead of a .env file - see CLAUDE.md's Deploy section.

SECRET_KEY=change-me-to-a-real-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Render sets this automatically to the service's own *.onrender.com host -
# no need to set it by hand, it's appended to ALLOWED_HOSTS (and, as
# https://<host>, to CSRF_TRUSTED_ORIGINS below) if present.
# RENDER_EXTERNAL_HOSTNAME=

# Comma-separated list of origins (scheme + host, no path) this API's own
# pages - e.g. /admin/ - are loaded from, needed so Django's CSRF check
# trusts POSTs coming back from them. Only needed for extra origins beyond
# the auto-appended RENDER_EXTERNAL_HOSTNAME above (e.g. a future custom
# domain like https://api.kpground.com). Not the same as CORS_ALLOWED_ORIGINS
# below, which is about other origins' JS calling this API, not this API's
# own forms.
# CSRF_TRUSTED_ORIGINS=

# Neon connection string, e.g.
# postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/dbname?sslmode=require
# Omit entirely for local dev to fall back to SQLite.
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call this API.
# 8080 (not 8000) for local KatTrap dev - this API's own dev server
# already runs on 8000 (manage.py runserver's default), so serve KatTrap
# locally with e.g. `python3 -m http.server 8080` from its repo root.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://kattrap.kpground.com,https://kpground.com

# Temporary no-password login for Kathryn's seeded account. See accounts app.
ENABLE_KATHRYN_QUICKLOGIN=True
