# Copy to .env for local dev. Never commit the real .env.

SECRET_KEY=change-me-to-a-real-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon connection string, e.g.
# postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/dbname?sslmode=require
# Omit entirely for local dev to fall back to SQLite.
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:8000,https://kattrap.kpground.com,https://kpground.com

# Temporary no-password login for Kathryn's seeded account. See accounts app.
ENABLE_KATHRYN_QUICKLOGIN=True
